      },
      "expressions": [
        {
          "text": "set an example",
          "relationship": "core"
        },
        {
          "text": "set a good example",
          "relationship": "variant"
        },
        {
          "text": "set a bad example",
          "relationship": "variant"
        },
        {
          "text": "lead by example",
          "relationship": "related",
          "note": "Emphasizes leadership through actions."
        }
      ]
    },
    {
      "id": "contrast_tradeoffs",
      "function": "Contrast facts, perspectives, or trade-offs",
      "owner": {
        "family": "patterns",
        "key": "clause, whereas/while + clause · On the one hand, + clause; on the other hand, + clause · One advantage/disadvantage of + noun/V-ing + is that + clause"
      },
      "expressions": [
        {
          "text": "whereas",
          "relationship": "core"
        },
        {
          "text": "while",
          "relationship": "near_synonym",
          "note": "While can also express time."
        },
        {
          "text": "on the one hand",
          "relationship": "related"
        },
        {
          "text": "on the other hand",
          "relationship": "related"
        },
        {
          "text": "the flip side",
          "relationship": "related",
          "note": "Another side, which may be positive or negative."
        },
        {
          "text": "on the flip side",
          "relationship": "variant"
        },
        {
          "text": "the downside",
          "relationship": "related",
          "note": "Specifically negative."
        },
        {
          "text": "advantage",
          "relationship": "related"
        },
        {
          "text": "disadvantage",
          "relationship": "related"
        },
        {
          "text": "come at the cost of",
          "relationship": "related"
        }
      ]
    },
    {
      "id": "retrospective_reflection",
      "function": "Reflect on past experiences with later knowledge",
      "owner": {
        "family": "patterns",
        "key": "Looking back, + clause · In retrospect/hindsight, + clause"
      },
      "expressions": [
        {
          "text": "looking back",
          "relationship": "core"
        },
        {
          "text": "in retrospect",
          "relationship": "near_synonym"
        },
        {
          "text": "in hindsight",
          "relationship": "near_synonym"
        }
      ]
    },
    {
      "id": "unavoidable_unintentional_reactions",
      "function": "Describe unavoidable reactions or noticing unintentional behavior",
      "owner": {
        "family": "patterns",
        "key": "can't help + V-ing · find myself + V-ing"
      },
      "expressions": [
        {
          "text": "can't help",
          "relationship": "core"
        },
        {
          "text": "can't help but",
          "relationship": "variant",
          "note": "Takes a base verb, not V-ing."
        },
        {
          "text": "find myself",
          "relationship": "related",
          "note": "Notice behavior rather than claim it cannot be controlled."
        }
      ]
    },
    {
      "id": "modest_opinion",
      "function": "Offer an opinion without insisting on it",
      "owner": {
        "family": "patterns",
