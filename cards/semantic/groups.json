      "function": "Explain an outcome or discovery",
      "owner": {
        "family": "patterns",
        "key": "It turns out (that) + clause · X turned out to be + adjective/noun · end up + V-ing / with + noun / in + place"
      },
      "expressions": [
        {
          "text": "it turns out",
          "relationship": "core"
        },
        {
          "text": "turned out to be",
          "relationship": "variant"
