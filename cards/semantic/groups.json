        "family": "patterns",
        "key": "When it comes to + noun/V-ing, + clause · As for + noun, + clause · As far as + noun + is concerned, + clause"
      },
      "expressions": [
        {
          "text": "when it comes to",
          "relationship": "core"
        },
        {
          "text": "as for",
          "relationship": "related"
        },
        {
          "text": "as far as is concerned",
          "relationship": "related"
        }
      ]
    },
    {
