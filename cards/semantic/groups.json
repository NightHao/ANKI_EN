      "owner": {
        "family": "patterns",
        "key": "have/has been meaning to + base verb"
      },
      "expressions": [
        {
          "text": "have been meaning to",
          "relationship": "core"
        },
        {
          "text": "I've been meaning to",
          "relationship": "variant"
        },
        {
          "text": "has been meaning to",
          "relationship": "variant"
        }
      ]
    },
    {
