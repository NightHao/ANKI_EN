{
  "schema_version": 1,
  "groups": [
    {
      "id": "admiration",
      "function": "Express respect or admiration",
      "owner": {
        "family": "vocabulary",
        "key": "regard"
      },
      "expressions": [
        {
          "text": "regard",
          "relationship": "core"
        },
        {
          "text": "look up to",
          "relationship": "related",
          "note": "Often suggests a role model or someone worth emulating."
        },
        {
          "text": "have great regard for",
          "relationship": "variant"
        },
        {
          "text": "hold someone in high regard",
          "relationship": "variant"
        }
      ]
    },
    {
      "id": "exemplary_behavior",
      "function": "Demonstrate behavior others may follow",
      "owner": {
        "family": "patterns",
